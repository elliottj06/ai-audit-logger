# Server auth — set this to protect your dashboard and API
# Leave blank for local/open access
API_KEY=

AUDIT_SERVER_URL=http://localhost:8000
AUDIT_APP_NAME=my-app
AUDIT_ENABLED=true
AUDIT_REDACT_PROMPTS=false
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_audit

# AI Provider keys (used by proxy mode — or configure via dashboard)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Slack alerts (optional)
SLACK_WEBHOOK_URL=
ALERT_COST_PER_CALL=0.50
ALERT_HOURLY_COST=5.00

# Spend budgets (0 = no limit)
BUDGET_DAILY_USD=0
BUDGET_MONTHLY_USD=0
